  dialogueText: {fileID: 810163867}
  dialogueLines:
  - text: I remember the rain.
    audioClip: {fileID: 8300000, guid: f7b909b2e9ef61b4e9d447b80a9a87f0, type: 3}
    pauseAfter: 1.2
  - text: I remember the house.
    audioClip: {fileID: 8300000, guid: fda1317a97e7ebc4a93247e9d279c3e2, type: 3}
    pauseAfter: 1.2
  - text: But I don't remember...
    audioClip: {fileID: 8300000, guid: ad00450a4c2aad749b6d652341698ec5, type: 3}
    pauseAfter: 1.8
  - text: His face.
